{
  "name": "@mjakl/pi-where-am-i",
  "version": "0.1.0",
  "description": "Always-visible contextual request and live activity lines for Pi sessions",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "HOW_IT_WORKS.md",
    "LICENSE",
    "where-am-i.example.json"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm pack --dry-run >/dev/null",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "status",
    "session-summary"
  ],
  "author": "Michael Jakl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjakl/pi-where-am-i.git"
  },
  "bugs": {
    "url": "https://github.com/mjakl/pi-where-am-i/issues"
  },
  "homepage": "https://github.com/mjakl/pi-where-am-i#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22.19.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
